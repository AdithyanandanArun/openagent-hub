# Force LF line endings for files that must not have CRLF (shell scripts, Docker)
*.sh        text eol=lf
Dockerfile* text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.conf      text eol=lf
*.env*      text eol=lf
