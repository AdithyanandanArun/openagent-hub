# Development-only defaults. Production must provide these through Secret Manager.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-development-secret
ENCRYPTION_KEY=
PREVIOUS_ENCRYPTION_KEY=
DATABASE_URL=postgresql://postgres:postgres@db:5432/openagent
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=http://localhost:3000
ENABLE_OPENAI_COMPAT_API=true
ENABLE_CUSTOM_MCP_SERVERS=true
ENABLE_WORKSPACE_OPEN=true
STORAGE_BACKEND=local
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
REDIS_URL=
AUTH_REQUESTS_PER_HOUR=20
CHAT_REQUESTS_PER_MINUTE=20
CHAT_REQUESTS_PER_DAY=500
MAX_CONCURRENT_CHAT_REQUESTS=2
ENABLE_HEALTH_PROBES=true
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_DELIVERY_MODE=console
RESEND_API_KEY=
EMAIL_FROM=
INVITE_ONLY=false
INVITED_EMAILS=
RUN_MIGRATIONS=true
